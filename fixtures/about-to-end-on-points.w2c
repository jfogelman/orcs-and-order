rimtooth has fallen into disorder.","kind":"bad"},{"turn":275,"player":0,"text":"Mudhole has fallen into disorder.","kind":"bad"},{"turn":275,"player":0,"text":"Second Mudhole has fallen into disorder.","kind":"bad"},{"turn":275,"player":0,"text":"Definitely Not Mudhole grows to 10.","kind":"growth","cue":"growth"},{"turn":275,"player":1,"text":"Aldenwatch completes Knight.","kind":"good","cue":"built"},{"turn":275,"player":1,"text":"Silverbrook has fallen into disorder.","kind":"bad"},{"turn":275,"player":1,"text":"Thornwall has fallen into disorder.","kind":"bad"},{"turn":275,"player":1,"text":"Highmarch sells its Chapel of Mild Optimism to cover the books.","kind":"bad"},{"turn":275,"player":1,"text":"One of the figures out there is not what it has been pretending to be.","kind":"good","at":[18,22]},{"turn":275,"player":1,"text":"Knight defeats Grub after 19 rounds.","kind":"combat","at":[28,10],"actor":355},{"turn":275,"player":3,"text":"Grub is wiped out.","kind":"bad","at":[28,10]},{"turn":275,"player":1,"text":"Knight is promoted.","kind":"good","cue":"promote","at":[27,9]},{"turn":275,"player":1,"text":"Knight defeats Grub after 19 rounds.","kind":"combat","at":[32,8],"actor":369},{"turn":275,"player":3,"text":"Grub is wiped out.","kind":"bad","at":[32,8]},{"turn":275,"player":1,"text":"Knight is promoted.","kind":"good","cue":"promote","at":[33,9]},{"turn":275,"player":3,"text":"Second Hollow is founded.","kind":"good","cue":"city-founded"},{"turn":276,"player":0,"text":"Bonechew completes Two Orcs.","kind":"good","cue":"built"},{"turn":276,"player":0,"text":"Definitely Not Mudhole completes Four Orcs.","kind":"good","cue":"built"},{"turn":276,"player":1,"text":"Peasant finishes Tidy Furrows.","kind":"good","at":[12,19]},{"turn":276,"player":1,"text":"Highmarch grows to 9.","kind":"growth","cue":"growth"},{"turn":276,"player":1,"text":"Highmarch completes Chapel of Mild Optimism.","kind":"good","cue":"built"},{"turn":276,"player":1,"text":"Fairhaven has fal