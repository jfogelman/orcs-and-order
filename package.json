{
  "name": "orcs-and-order",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "A small, extremely tongue-in-cheek turn-based 4X where orcs slowly discover that two orcs can stand in the same place.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "art": "python tools/prepare_art.py",
    "sweep": "vitest run --config vitest.sweep.config.ts tools/sweep.run.test.ts",
    "diagnose": "vitest run --config vitest.sweep.config.ts tools/founding.run.test.ts",
    "composition": "vitest run --config vitest.sweep.config.ts tools/composition.run.test.ts",
    "growth": "vitest run --config vitest.sweep.config.ts tools/growth.run.test.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
